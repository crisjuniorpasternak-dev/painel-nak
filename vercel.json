{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/sync?tipo=completa",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/sync?tipo=incremental&fonte=omie",
      "schedule": "45 8 * * *"
    }
  ],
  "functions": {
    "api/sync.js": {
      "maxDuration": 300
    },
    "api/dados.js": {
      "maxDuration": 30
    },
    "api/conferencia.js": {
      "maxDuration": 30
    }
  }
}
