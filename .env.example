# Copie para a Vercel em Settings → Environment Variables. Nunca coloque os valores reais no repositório.

# Token da API do DataCrazy (Configurações → API → Gerar chave). Só leitura é usada.
DATACRAZY_TOKEN=

# Banco Postgres: a integração Neon da Vercel preenche sozinha.
DATABASE_URL=

# Senha do acesso de emergência (entra com o e-mail "admin"). Serve para o primeiro login e para criar os demais acessos.
PAINEL_SENHA=

# Texto aleatório com 32+ caracteres para assinar o login (ex.: gere com `openssl rand -hex 32`).
SESSAO_SEGREDO=

# Texto aleatório que protege a rota de sincronização (a Vercel Cron usa sozinha).
CRON_SECRET=

# Opcionais
# PIPELINE_VENDAS_ID=9d747f1e-94d7-4fce-9e78-48a0b00c6e60
# PIPELINE_CICLO_ID=
# ETAPAS_IGNORADAS=Duplicado
# SINCRONIZAR_DESDE=2024-01-01T00:00:00Z
# SINCRONIZAR_DIAS=3
